{
  "name": "browser-helm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first a11y-first browser agent extension.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run tests/node",
    "test:e2e": "npm run build && playwright test",
    "debug:extension": "npm run build && tsx scripts/debug-extension.ts",
    "debug:extension:watch": "BROWSER_HELM_DEBUG_WATCH=1 npm run debug:extension",
    "agent:dev": "npm run build && tsx scripts/run-agent-dev.ts"
  },
  "dependencies": {
    "@wxt-dev/module-react": "latest",
    "aria-query": "latest",
    "dexie": "latest",
    "dom-accessibility-api": "latest",
    "lucide-react": "^1.16.0",
    "react": "latest",
    "react-dom": "latest",
    "wxt": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "latest",
    "@types/node": "^25.9.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "happy-dom": "^20.9.0",
    "tsx": "^4.22.3",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "^4.1.7"
  }
}
