{
  "name": "browser-helm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first a11y-first browser agent extension.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "build:landing": "npm run zip && npx tsx scripts/build-landing-page.ts",
    "preflight": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "setup:hooks": "tsx scripts/setup-pre-commit-hook.ts",
    "postinstall": "npm run setup:hooks",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run tests/node",
    "test:e2e": "npm run build && playwright test",
    "debug:extension": "npm run build && tsx scripts/debug-extension.ts",
    "debug:extension:watch": "BROWSER_HELM_DEBUG_WATCH=1 npm run debug:extension",
    "agent:dev": "npm run build && tsx scripts/run-agent-dev.ts"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "animal-island-ui": "^0.9.4",
    "aria-query": "5.3.2",
    "dexie": "4.4.2",
    "dom-accessibility-api": "0.7.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "wxt": "0.20.26",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "0.1.42",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "^20.9.0",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "tmp": "0.2.6",
    "uuid": "11.1.1"
  }
}
